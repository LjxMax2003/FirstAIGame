# ---------------------------------------------------------------- 引擎与工具二进制
# Godot 引擎本体不进仓库（165MB + 79MB）。用官方下载，版本见 README。
tools/godot46/
tools/godot.zip

# ---------------------------------------------------------------- Godot 生成物
# .godot/ 是导入缓存（含纹理/字体的 .import 派生资源），每次打开工程会重建。
# 但 *.import 文件必须提交 —— 它们记录导入参数，.tscn 靠它找资源。
.godot/
*.translation

# 导出产物
build/
export/*.exe
export/*.pck
export/*.apk
export/*.aab

# ---------------------------------------------------------------- 阶段快照
# _p1_backup / _p2_backup 是 v7 之前的阶段回滚快照，内容是完整工程的旧副本。
# 提交它们等于把同一份代码放进仓库三遍，且会让「当前代码」检索出三份结果。
GameDemo/_p1_backup/
GameDemo/_p2_backup/

# ---------------------------------------------------------------- 运行期产物（验证日志、截图）
# 这些是本机跑门禁时的输出，不是源码。留一份代表性的截图在 docs 里即可。
GameDemo/first-xi-xue-gui/*.log
GameDemo/first-xi-xue-gui/shots/*.png

# ---------------------------------------------------------------- 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
__pycache__/
*.pyc

# ---------------------------------------------------------------- AI 助手工作目录
# .workbuddy/ 是 AI 助手的工作记忆与临时状态，不属于项目产物。
.workbuddy/
# .qoder-credits/ 是 AI 编辑器的用量统计与内部会话导出，含工具内部信息。
.qoder-credits/

# ---------------------------------------------------------------- 美术构建的引擎日志
# 只是 Godot 跑生成脚本时的 stdout，不是源材料（.mjs/.py 才是）。
assets/**/*_run.log
