# =====================================================================
# 本仓库只提交两样东西：游戏本体工程 + 可直接运行的启动器（发布包）。
# 策划案、数值模型、阶段报告、美术源库与生成器等「过程材料」不纳入版本库，
# 它们留在本地工作区，必要时应另行归档。
# =====================================================================

# ---------------------------------------------------------------- 引擎与工具二进制
# Godot 引擎本体（79MB zip / 解包后的编辑器）不进仓库。版本见 README。
/tools/

# ---------------------------------------------------------------- 工程以外的过程材料
/assets/
/docs/
/reports/
/iron_flower_reference.md
.tmp_work/

# ---------------------------------------------------------------- Godot 生成物
# .godot/ 是导入缓存，每次打开工程会重建；
# 但 *.import 必须提交 —— 它们记录导入参数，.tscn 靠它找资源。
.godot/
*.translation

# 导出中间产物
build/
export/*.exe
export/*.pck
export/*.apk
export/*.aab

# ---------------------------------------------------------------- 发布包二进制
# GitHub 单文件上限 100MB，Windows 单文件 exe 实测 110MB，进不了普通仓库。
# 三个二进制统一走 Release 附件分发（见 release/README.md），仓库只留校验值与说明。
/release/*.zip
/release/*.exe
/release/*.apk
/release/windows/
/release/android/

# ---------------------------------------------------------------- 阶段快照
# 完整工程的旧副本，提交等于同一份代码放三遍。
GameDemo/_p1_backup/
GameDemo/_p2_backup/

# ---------------------------------------------------------------- 运行期产物
GameDemo/first-xi-xue-gui/*.log
# 截图只保留少量代表帧（README 展示用），其余跑门禁时现生成。
GameDemo/first-xi-xue-gui/shots/*.png
!GameDemo/first-xi-xue-gui/shots/readme_*.png

# ---------------------------------------------------------------- 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
__pycache__/
*.pyc

# ---------------------------------------------------------------- AI 助手工作目录
.workbuddy/
.qoder-credits/

# ---------------------------------------------------------------- 美术构建的引擎日志
assets/**/*_run.log
