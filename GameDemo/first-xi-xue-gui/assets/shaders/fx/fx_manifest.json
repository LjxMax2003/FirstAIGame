{
  "schema_version": 1,
  "pack": "shouyiren-fx",
  "title_zh": "《守艺人·百工夜行》视觉特效包",
  "generated": "2026-10-27",
  "curated_from": "https://godotshaders.com/shader/?orderby=date&order=DESC",
  "godot": "4.6 / 4.7（已在 4.6 stable + mobile 渲染后端实跑验证）",
  "renderer": [
    "mobile",
    "gl_compatibility",
    "forward_plus"
  ],
  "viewport": [
    720,
    1280
  ],
  "principles": [
    "全部为 canvas_item，不含 SCREEN_TEXTURE / DEPTH_TEXTURE 采样，移动端与 Compatibility 通吃",
    "全部参数走 uniform 并带 hint，Inspector 里可直接调，不写死魔法数",
    "modulate / self_modulate 统一在 vertex() 取出、最后相乘，特效不会吞掉节点调色",
    "单个节点只能挂一个 ShaderMaterial —— 材质接管与还原统一由 scripts/ShaderFX.gd 负责"
  ],
  "categories": {
    "hit": "受击反馈",
    "spawn": "敌人出现 / 消失",
    "light": "光效",
    "item": "道具",
    "skill": "技能"
  },
  "skill_subcategories": {
    "cast": "技能发动 / 一次性演出（slash_arc、cast_burst、projectile_trail）",
    "rank": "技能升级区分，常驻（skill_rank_rim）",
    "field": "技能持续表现，常驻（aura_field）"
  },
  "skill_integration_points": {
    "slash_arc": "scripts/weapons/WeaponManager.gd → fire_whip() 的 _push_fx() 之后 ShaderFX.slash(arc, 0.12, false, false)；flip 传 false（方向已由 flip_h 翻转），restore 传 false（池化精灵由 _take_fx() 剥材质）",
    "cast_burst": "fire_whip() 与 fire_halo() → ShaderFX.burst_ellipse(parent, center, long_px, short_px, color, rays, duration)。横扫 long=length*2 / short=width / rays=0；花灯是圆心为正圆、只在真的烧到目标时放。⚠️ 不要直接传 squash=(1.7,0.5)：那会把椭圆长轴挤出节点被裁掉，见 fx-pack.md §9.6 ②",
    "skill_rank_rim": "scripts/ui/HUD.gd → _sync_weapon_row() 里对槽位 TextureRect 调 ShaderFX.set_rank(ic, level, evolved)，必须在 set_size 之后（框宽要按 源图宽/显示宽 换算）",
    "aura_field": "scripts/GarlicRing.gd → _ready() 建场（并压成贴边窄带）、set_radius() 里 field_resize()、beat() 里 field_beat()",
    "area_ripple": "GarlicRing.gd（花灯第二层）。⚠️ 和 aura_field 是叠加不是替代：边带管“边界在哪”，波纹管“圈里在烧”。皮影的轨迹圈已删除（见 effects 里 not_used_by）",
    "projectile_trail": "WeaponManager.fire_projectile() 里糖画/剪纸挂 set_trail(axis=0)，_release_bullet() 里还原。自转的弹体（打铁花）不挂：拖尾在贴图 UV 里，自转会让尾巴绕圈"
  },
