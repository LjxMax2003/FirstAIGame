#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
《守艺人·百工夜行》v4 技能扩充 + 中期难度 —— 解析式模型

用途：为 docs/design/skills-and-midgame-v4.md 生成全部表格数字。
口径与 docs/balance/balance_model.py 一致（R = 供给DPS / 需求HP-per-s），
新增部分单独实现，不改旧脚本：
  · 命中数上限随等级成长（cap_eff）—— 修掉"低等级 AoE 在高密度下直接撞上限"的老问题
  · 真实等级预算（1 级 = 1 pick，武器 8 级 / 被动 5 级 / 6 武器槽）
  · 浆壳兵（AoE 减伤）与中期占比时间表
  · 进化（不占 pick）对后期供给的贡献
  · 三选一抽取池概率

运行：
    python v4_model.py
    python v4_model.py --json v4_result.json
"""

import json
import math
import argparse
from pathlib import Path

HERE = Path(__file__).resolve().parent

VIEW_W, VIEW_H = 720.0, 1280.0
AREA_SCREEN = VIEW_W * VIEW_H

# ============================================================ 敌潮（沿用 v3.1）
HP_BASE, HP_REF, HP_EXP = 3.0, 1800.0, 1.70
SPAWN_IV = (1.1, 0.45, 600.0)
BATCH = (6.0, 0.01, 30)
ELITE_HP_MULT = 18.0
MOB_MEAN_HP_MULT = (1.0 + 0.6 + 1.8) / 3.0
MAX_ALIVE = 400
WAVES = [(0, 300, 0.00), (300, 600, 0.06), (600, 1200, 0.10), (1200, 1500, 0.14), (1500, 1800, 0.18)]


def ehp(t):
    return HP_BASE * (1.0 + t / HP_REF) ** HP_EXP


def spawn_interval(t):
    a = min(1.0, t / SPAWN_IV[2])
    return SPAWN_IV[0] + (SPAWN_IV[1] - SPAWN_IV[0]) * a


def batch(t):
    return min(BATCH[0] + BATCH[1] * t, BATCH[2])


def lam(t):
    return batch(t) / spawn_interval(t)


def elite_share(t):
    for a, b, s in WAVES:
        if a <= t < b:
            return s
    return WAVES[-1][2]


def density(t):
    speed = 0.5 * (60.0 + 95.0)
    travel = (760.0 - 24.0) / speed
    return min(lam(t) * travel, MAX_ALIVE)


SHELL_HP_MULT = 1.5
SHELL_AOE_TAKEN = 0.65     # 浆壳吃 AoE 只有 0.65 倍


def shell_share(t):
    if t < 360:
        return 0.0
    if t < 840:
        return 0.30 * (t - 360) / 480.0
    if t < 1080:
        return 0.30
    return max(0.10, 0.30 - 0.20 * (t - 1080) / 720.0)


def demand(t, use_shell=True):
    s = shell_share(t) if use_shell else 0.0
    mob = MOB_MEAN_HP_MULT + s * (SHELL_HP_MULT - 1.0)
    es = elite_share(t)
    return lam(t) * ((1.0 - es) * ehp(t) * mob + es * ehp(t) * ELITE_HP_MULT)


# ============================================================ 武器表 v4
# arche 决定命中数口径；cap 是"命中数上限"，实际按 cap_eff 随等级成长。
WEAPONS = {
    "whip": dict(name="傩面·师刀", arche="sweep", kind="aoe", cd=1.30, dmg=11.0, per=1.20,
                 length=110.0, len_per=12.0, width=64.0, len_cap=260.0, cap=8),
    "halo": dict(name="花灯", arche="aura", kind="aoe", cd=0.50, dmg=3.60, per=0.65,
                 radius=70.0, r_per=7.0, cap=10, slow=0.15),
    "glowstick": dict(name="糖画", arche="locked", kind="single", cd=1.00, cd_per=0.05,
                      dmg=11.0, per=2.40, pierce=1, aim=0.88, cap_proj=4),
    "phone": dict(name="皮影", arche="orbit", kind="aoe", cd=1.10, dmg=11.0, per=1.30,
                  radius=58.0, r_per=5.0, count=2, cap=12),
    "blade": dict(name="剪纸", arche="bounce", kind="single", cd=0.85, cd_per=0.04,
                  dmg=10.0, per=2.60, bounce=3, aim=0.75),
    "extinguisher": dict(name="打铁花", arche="arc", kind="aoe", cd=1.60, dmg=15.0, per=1.80,
                         count=2, path_len=320.0, path_w=36.0, hit_cap=4),
    "gong": dict(name="铜锣", arche="aura", kind="aoe", cd=1.80, dmg=14.0, per=2.00,
                 radius=150.0, r_per=10.0, cap=8, amp=0.12),
    "inkline": dict(name="墨斗", arche="line", kind="single", cd=0.90, cd_per=0.04,
                    dmg=16.0, per=8.00, pierce=1, aim=0.90, shell_bonus=1.80),
    "print": dict(name="木版年画", arche="zone", kind="aoe", cd=2.20, dmg=30.0, per=3.50,
                  radius=105.0, cap=6, delay=0.45, focus=1.8),
}

MAX_WEAPON_LV = 8
SLOTS = 6
STAT_MAX = 5

# 进化：不占 pick，+dps_mult / +area_mult
EVOLUTIONS = {
    "whip": dict(req="damage", dps=1.70, area=1.50, name="火神开脸"),
    "halo": dict(req="area", dps=1.40, area=1.60, name="走马灯"),
    "glowstick": dict(req="cooldown", dps=1.50, area=1.00, name="龙凤呈祥"),
    "gong": dict(req="area", dps=1.50, area=1.50, name="开市锣"),
    "inkline": dict(req="damage", dps=1.55, area=1.10, name="龙筋墨线"),
}


def stat_mult(kind, lv):
    lv = max(0, int(lv))
    if kind == "damage":
        return 1.0 + 0.10 * min(lv, STAT_MAX)
    if kind == "cooldown":
        return max(0.40, 1.0 - 0.05 * min(lv, STAT_MAX))
    if kind == "area":
        return 1.0 + 0.07 * min(lv, STAT_MAX)
    if kind == "speed":
        return 1.0 + 0.08 * min(lv, STAT_MAX)
    if kind == "max_hp":
        return 100.0 + 20.0 * min(lv, STAT_MAX)
    if kind == "might":
        return max(0.50, 1.0 - 0.07 * min(lv, STAT_MAX))
    return 1.0


def cap_eff(lv, cap):
    """命中数上限随等级成长：Lv1 = 1，Lv8 = cap。"""
    return 1.0 + (cap - 1.0) * (lv - 1) / float(MAX_WEAPON_LV - 1)


def weapon_hits(wid, lv, pv, n_alive):
    w = WEAPONS[wid]
    a = w["arche"]
    dens = n_alive / AREA_SCREEN
    if a == "sweep":
        ln = min((w["length"] + w["len_per"] * (lv - 1)) * stat_mult("area", pv.get("area", 0)), w["len_cap"])
        cover = math.pi * (ln * 0.5) ** 2 * 0.5
        return max(1.0, min(cover * dens, cap_eff(lv, w["cap"])))
    if a == "aura":
        r = (w["radius"] + w["r_per"] * (lv - 1)) * stat_mult("area", pv.get("area", 0))
        cover = math.pi * r * r * 0.5
        return max(1.0, min(cover * dens, cap_eff(lv, w["cap"])))
    if a == "orbit":
        r = (w["radius"] + w["r_per"] * (lv - 1)) * stat_mult("area", pv.get("area", 0))
        cnt = w["count"] + (1 if lv >= 4 else 0) + (1 if lv >= 7 else 0)
        base = math.pi * r * r * 0.5 * dens + (cnt - 2) * 0.8
        return max(1.0, min(base, cap_eff(lv, w["cap"])))
    if a == "arc":
        per_bullet = max(1.0, min(w["path_len"] * w["path_w"] * dens, cap_eff(lv, w["hit_cap"])))
        return per_bullet * w["count"]
    if a == "locked":
        n = min(1 + (lv - 1) // 2, WEAPONS[wid]["cap_proj"])
        return float(n)
    if a == "bounce":
        return 1.0 + w["bounce"] * 0.70
    if a == "line":
        return 1.0 + 0.35 * w["pierce"]
    if a == "zone":
        cover = math.pi * w["radius"] ** 2 * 0.5 * dens * w["focus"]
        return max(1.0, min(cover, cap_eff(lv, w["cap"])))
    raise KeyError(a)


def weapon_dps(wid, lv, pv, n_alive, evo=None):
    """-> (total_dps, single_target_dps)"""
    w = WEAPONS[wid]
    dM = stat_mult("damage", pv.get("damage", 0))
    cM = stat_mult("cooldown", pv.get("cooldown", 0))
    dmg = (w["dmg"] + w["per"] * (lv - 1)) * dM
    cd = w["cd"]
    if "cd_per" in w:
        cd = max(0.15, cd * (1 - w["cd_per"] * (lv - 1)))
    cd *= cM
    mult = 1.0
    if evo:
        dmg *= EVOLUTIONS[wid]["dps"]
        mult = EVOLUTIONS[wid]["dps"]
    h = weapon_hits(wid, lv, pv, n_alive)
    if w["arche"] in ("locked", "bounce", "line"):
        dmg *= w["aim"]
    total = dmg * h / cd
    single = dmg / cd
    return total, single


def build_dps(weapons, pv, n_alive, evolved=None):
    evolved = evolved or set()
    aoe = single_w = 0.0
    for wid, lv in weapons.items():
        d, _ = weapon_dps(wid, lv, pv, n_alive, wid in evolved)
        if WEAPONS[wid]["kind"] == "aoe":
            aoe += d
        else:
            single_w += d
    return aoe + single_w, aoe, single_w


# ============================================================ 升级预算
PICKUP = 0.90
DEF_ORDER = ["might", "max_hp", "regen", "shield", "speed"]
DPS_ORDER = ["damage", "cooldown", "area"]
PICK_ORDER = ["whip", "halo", "glowstick", "gong", "print", "inkline", "phone", "blade", "extinguisher"]


def xp_need(level, exp):
    return 5.0 + level ** exp


def policy_pick(state, n):
    """中位玩家 = 贪心 DPS（真实玩家会集中加深），每 5 次 pick 让 1 次给防御"""
    wp, pv = state["weapons"], state["pv"]
    if state["picks"] % 5 == 0:
        for k in DEF_ORDER:
            if pv.get(k, 0) < STAT_MAX:
                pv[k] += 1
                return
    base, _, _ = build_dps(wp, pv, n)
    best = None
    for wid in PICK_ORDER:
        lv = wp.get(wid, 0)
        if lv >= MAX_WEAPON_LV:
            continue
        if lv == 0 and len(wp) >= SLOTS:
            continue
        w2 = dict(wp)
        w2[wid] = lv + 1
        gain = build_dps(w2, pv, n)[0] - base
        if best is None or gain > best[0]:
            best = (gain, "w", wid)
    for k in DPS_ORDER:
        if pv.get(k, 0) >= STAT_MAX:
            continue
        p2 = dict(pv)
        p2[k] += 1
        gain = build_dps(wp, p2, n)[0] - base
        if best is None or gain > best[0]:
            best = (gain, "p", k)
    if best is None:
        return
    if best[1] == "w":
        wp[best[2]] = wp.get(best[2], 0) + 1
    else:
        pv[best[2]] += 1


def _has_passive_room(pv):
    return any(pv.get(k, 0) < STAT_MAX for k in DPS_ORDER + DEF_ORDER)


def run(exp, cap, use_shell=True, use_evo=True, dt=5.0, t_end=1800):
    st = dict(weapons={"whip": 1}, pv={k: 0 for k in ("damage", "cooldown", "area", "speed",
                                                      "might", "max_hp", "regen", "shield")},
              picks=0)
    level, xp_pool = 1, 0.0
    evolved = set()
    evo_queue = {}
    rows = []
    for i in range(int(t_end / dt) + 1):
        t = i * dt
        n = density(t)
        dps, aoe, single = build_dps(st["weapons"], st["pv"], n, evolved)
        dem = demand(t, use_shell)
        s = shell_share(t) if use_shell else 0.0
        dps_eff = aoe * (1 - s * (1 - SHELL_AOE_TAKEN)) + single
        rows.append(dict(t=t, lv=level, picks=st["picks"], dps=round(dps), aoe=round(aoe),
                         single=round(single), demand=round(dem), R=round(dps_eff / dem, 2),
                         R_raw=round(dps / dem, 2), alive=round(n),
                         weapons=dict(st["weapons"]), pv=dict(st["pv"]), evolved=sorted(evolved)))
        if t >= t_end:
            break
        # 经验
        es = elite_share(t)
        xp_each = (1 - es) * 1 + es * 12
        xp_pool += lam(t) * xp_each * dt * PICKUP * min(1.0, dps_eff / dem)
        while level < cap and xp_pool >= xp_need(level, exp):
            xp_pool -= xp_need(level, exp)
            level += 1
            st["picks"] += 1
            policy_pick(st, n)
        # 进化：条件满足后 90 秒兑现（等宝箱）
        if use_evo:
            for wid, lv in list(st["weapons"].items()):
                if wid in evolved or wid not in EVOLUTIONS:
                    continue
                req = EVOLUTIONS[wid]["req"]
                if lv >= MAX_WEAPON_LV and st["pv"].get(req, 0) >= 1:
                    evo_queue.setdefault(wid, t)
            for wid, t0 in list(evo_queue.items()):
                if t - t0 >= 90.0 and wid not in evolved:
                    evolved.add(wid)
                    del evo_queue[wid]
    return rows


def pick_row(rows, m):
    return next((r for r in rows if abs(r["t"] - m) < 1e-6), None)


# ============================================================ 报告
MARKS = [0, 60, 300, 600, 900, 1200, 1500, 1800]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--json", default="v4_result.json")
    a = ap.parse_args()

    cur = run(2.00, 999, use_shell=False, use_evo=True)     # 现状（代码口径）
    v31 = run(2.25, 48, use_shell=False, use_evo=True)      # v3.1 文档口径
    v4 = run(2.25, 48, use_shell=True, use_evo=True)        # v4

    band = []
    for wid, w in WEAPONS.items():
        n30 = density(1800)
        d1, s1 = weapon_dps(wid, 1, {}, n30)
        d8, s8 = weapon_dps(wid, 8, {}, n30)
        band.append(dict(id=wid, name=w["name"], kind=w["kind"], arche=w["arche"],
                         lv1=round(d1), lv8=round(d8), single8=round(s8),
                         h8=round(weapon_hits(wid, 8, {}, n30), 1),
                         cap=w.get("cap", w.get("hit_cap", w.get("bounce")))))

    def curve_rows(rows):
        out = []
        for m in MARKS:
            r = pick_row(rows, m)
            if r:
                out.append(dict(mm="%02d:%02d" % (m // 60, m % 60), t=m, lv=r["lv"], picks=r["picks"],
                                dps=r["dps"], aoe=r["aoe"], single=r["single"],
                                demand=r["demand"], R=r["R"], R_raw=r["R_raw"],
                                weapons=r["weapons"], pv=r["pv"], evolved=r["evolved"]))
        return out

    res = dict(band=band, cur=curve_rows(cur), v31=curve_rows(v31), v4=curve_rows(v4),
               shell={str(m): round(shell_share(m), 2) for m in MARKS})

    with open(HERE / a.json, "w", encoding="utf-8") as f:
        json.dump(res, f, ensure_ascii=False, indent=1)

    print("== 武器收敛带（无被动，30min 密度 N=%d）" % density(1800))
    print("%-13s %-7s %-6s %-6s %-6s %-7s %-6s %-5s" %
          ("id", "名称", "伤害型", "Lv1总", "Lv8总", "Lv8单体", "h@Lv8", "上限"))
    for r in band:
        print("%-13s %-7s %-6s %-6d %-6d %-7d %-6.1f %s" %
              (r["id"], r["name"], r["kind"], r["lv1"], r["lv8"], r["single8"], r["h8"], r["cap"]))

    for label, rows in (("现状（exp2.0 无上限）", cur), ("v3.1 文档（exp2.25 cap48）", v31), ("v4（+浆壳）", v4)):
        print("\n== R 曲线 · %s" % label)
        print("%-6s %-4s %-6s %-7s %-8s %-6s %-7s %-6s" %
              ("时间", "Lv", "picks", "DPS", "需求HP/s", "R", "R无壳", "同屏"))
        for r in res["cur" if label.startswith("现状") else ("v31" if label.startswith("v3.1") else "v4")]:
            print("%-6s %-4d %-6d %-7d %-8d %-6.2f %-7.2f %d" %
                  (r["mm"], r["lv"], r["picks"], r["dps"], r["demand"], r["R"], r["R_raw"],
                   round(density(r["t"]))))
    print("\n== v4 30min 构筑")
    last = pick_row(v4, 1800)
    print("  Lv%d picks=%d weapons=%s" % (last["lv"], last["picks"], last["weapons"]))
    print("  passives=%s evolved=%s" % (last["pv"], last["evolved"]))
    print("  单体 DPS = %d" % last["single"])


if __name__ == "__main__":
    main()
